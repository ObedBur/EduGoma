// Prisma schema for Education Goma backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums (if needed in future) can be added here

model Tenant {
  id              String    @id @default(cuid())
  name            String    @unique
  phone           String    @unique // WhatsApp RDC (+243...)
  email           String?
  commune         String? // Goma/Karisimbi/Mugunga/Nyiragongo/Other
  type            String? // private/conventionned/community/public
  status          String    @default("pending") // pending/active/rejected/suspended
  rejectionReason String?
  validatedAt     DateTime?
  validatedBy     String?
  domain          String? // Optionnel maintenant
  /// trial | active | overdue | suspended (#43)
  subscriptionStatus String   @default("trial")
  subscriptionPaidAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  users              User[]
  roles              Role[]
  tenantModules      TenantModule[]
  accessLogs         AccessLog[]
  tenantLogs         TenantLog[]
  alerts             Alert[]
  tickets            Ticket[]
  notificationLogs   NotificationLog[]
  payments           Payment[]
  setupTokens        SetupToken[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String?  @unique
  phone     String?  @unique
  password  String
  firstName String?
  lastName  String?
  isActive  Boolean  @default(true)
  /// true tant que le compte n'a pas choisi son mot de passe via /set-password
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  userRoles             UserRole[]
  accessLogs            AccessLog[]
  refreshTokens         RefreshToken[]
  loginAttempts         LoginAttempt[]
  passwordResetTokens   PasswordResetToken[]
  passwordHistory       PasswordHistory[]
  setupTokens           SetupToken[]
}

/// Lien de création de mot de passe (usage unique, expiration courte)
model SetupToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  tenantId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model Role {
  id       String @id @default(cuid())
  tenantId String
  name     String
  level    Int?   // 1 = Super Admin (platform), 2 = Admin (school)

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String

  // Relations
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  // Relations
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Module {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  // Relations
  tenantModules TenantModule[]
}

model TenantModule {
  tenantId  String
  moduleId  String
  isEnabled Boolean @default(false)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@index([moduleId])
}

model AccessLog {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  action       String
  resourceType String?   // e.g., 'TENANT', 'USER', 'ROLE', 'PERMISSION', 'SYSTEM'
  resourceId   String?   // ID of the affected resource
  ip           String?
  userAgent    String?
  metadata     String?   // JSON string for additional data (no sensitive info)
  createdAt    DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([resourceType, resourceId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  tokenHash String   @unique
  userAgent String?
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model LoginAttempt {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  success      Boolean  @default(false)
  ip           String?
  userAgent    String?
  lockedUntil  DateTime?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  tokenHash    String   @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordHistory {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  passwordHash  String
  createdAt     DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model TenantLog {
  id        String   @id @default(cuid())
  tenantId  String
  action    String // registered, phone_verified, validated, rejected, suspended
  ip        String?
  userAgent String?
  metadata  String? // JSON string for additional data
  createdAt DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

/// Demandes de démonstration reçues depuis la landing page
model DemoRequest {
  id           String   @id @default(cuid())
  contactName  String
  schoolName   String
  phone        String
  email        String?
  studentRange String? // moins-de-100 | 100-300 | 300-600 | plus-de-600
  message      String?
  /// Workflow: nouveau → contacté → converti | nouveau → clôturé | contacté → clôturé
  status       String   @default("nouveau")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Alertes priorité plateforme
model Alert {
  id        String   @id @default(cuid())
  tenantId  String?
  type      String   // SECURITY, SYSTEM, BILLING, USAGE
  severity  String   @default("info") // info, warning, critical
  title     String
  message   String
  source    String?  // Nom du service/module à l'origine
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}

/// Tickets de support & onboarding écoles
model Ticket {
  id          String   @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  category    String   @default("general") // integration, billing, technical, general
  status      String   @default("open")    // open, in_progress, resolved, closed
  priority    String   @default("normal")  // low, normal, urgent, critical
  schoolName  String?
  schoolId    String?
  requester   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

/// Anti-doublon pour la séquence d'onboarding J+0…J+30 (#51)
model NotificationLog {
  id       String   @id @default(cuid())
  tenantId String
  /// j1_guide | j3_login_reminder | j7_import | j14_no_students | j27_trial | j30_suspend
  step     String
  /// email | whatsapp | alert | system
  channel  String
  sentAt   DateTime @default(now())
  success  Boolean  @default(true)
  errorMsg String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, step, channel])
  @@index([tenantId])
}

/// Paiements mensuels d'abonnement (#43)
model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  /// YYYY-MM (ex: 2026-09)
  period     String
  paidAt     DateTime @default(now())
  recordedBy String?
  note       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@index([paidAt])
}
