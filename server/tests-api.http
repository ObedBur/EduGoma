@baseUrl = http://localhost:3000
@tenantId = cmiw78ghk0000un74ln55bgj1
@authToken = {{login.response.body.data.accessToken}}

### ------------------------------------------------------------------------
### APPLICATION HEALTH CHECK
### ------------------------------------------------------------------------

### Check API Status
GET {{baseUrl}}/

### ------------------------------------------------------------------------
### AUTHENTICATION MODULE
### ------------------------------------------------------------------------

### A. Register (Email)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "nzulo@gmail.com",
  "password": "Nzulo123!@#",
  "firstName": "Nzulo",
  "lastName": "Muhanya",
  "tenantId": "{{tenantId}}"
}

### B. Login (Phone/Email)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nzulo@gmail.com",
  "password": "Nzulo123!@#"
}

### B2. Login Admin (Super Admin)
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "obedburindi@gmail.com",
  "password": "Obed2321Jtb"
}

### C. Get Current User Profile (Protected)
# Requires @authToken from the Login response
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### D. Refresh Token
# This endpoint relies on the httpOnly cookie 'refreshToken' set during login.
# IMPORTANT: The 'REST Client' extension handles cookies automatically if you have cookies enabled.
# If not, you may need to copy the refreshToken from the Set-Cookie header of the Login response.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

### E. Logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json

### ------------------------------------------------------------------------
### ERROR HANDLING TESTS
### ------------------------------------------------------------------------

### Invalid Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "wrong@example.com",
  "password": "wrong"
}

### Protected Route without Token
GET {{baseUrl}}/auth/me


